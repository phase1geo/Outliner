msgstr ""
"Créez et naviguez rapidement à travers des plans en utilisant le clavier ou "
"la souris."

#: data/io.github.phase1geo.outliner.appdata.xml.in:17
#, fuzzy
msgid "Full support for rich text formatting and/or Markdown formatting."
msgstr "Prise en charge complète de la mise en forme du texte."

#: data/io.github.phase1geo.outliner.appdata.xml.in:18
msgid "Add notes to any outline text."
msgstr "Ajoutez des notes à n'importe quel élément de plan."

#: data/io.github.phase1geo.outliner.appdata.xml.in:19
#, fuzzy
